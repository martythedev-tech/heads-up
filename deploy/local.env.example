# deploy/local.env: settings for deploy/deploy.sh on your laptop (not in git).
# Only needed if you deploy from a Linux laptop instead of installing on the
# server directly. deploy.sh reads the server's sudo password and the admin
# password from your keyring (secret-tool), never from files.

# ssh destination (a Host from ~/.ssh/config, or user@host)
SSH_HOST=myserver
# Optional: a program that prints the SSH password (for password logins);
# leave empty when you use SSH keys.
SSH_ASKPASS=
# secret-tool attributes of the server's sudo password in your keyring, e.g.
#   secret-tool store --label="myserver sudo" service ssh host myserver user me
SUDO_SECRET="service ssh host myserver user me"
