#!/bin/bash
# Set the password of the built-in "admin" account. Run as root on the server,
# from the Heads Up source directory.
#
#   sudo bash deploy/set-admin-password
#       asks for a password; leave it empty to have a strong one generated
#       (it is printed once)
#   printf '%s\n' "$PW" | sudo bash deploy/set-admin-password
#       reads the password from stdin (used by deploy/deploy.sh admin)
#
# Only a scrypt hash is stored, encrypted with this machine's key
# (systemd-creds) in /etc/credstore.encrypted/heads-up.admin-hash. Running this
# again resets the admin password, which is also the way back in if it's lost.
set -euo pipefail
cd "$(dirname "$0")/.."
[[ $EUID -eq 0 ]] || { echo "Run this as root: sudo bash deploy/set-admin-password" >&2; exit 1; }

generated=
if [[ -t 0 ]]; then
  read -rsp "New admin password (leave empty to generate one): " pw; echo
  if [[ -z $pw ]]; then
    pw=$(python3 -c 'import users; print(users.new_password())')
    generated=1
  else
    read -rsp "Type it again: " again; echo
    [[ $pw == "$again" ]] || { echo "The passwords don't match." >&2; exit 1; }
  fi
else
  IFS= read -r pw || true
fi
(( ${#pw} >= 10 )) || { echo "The password needs at least 10 characters." >&2; exit 1; }

hash=$(printf '%s\n' "$pw" | python3 deploy/hash-password)
install -d -m 700 /etc/credstore.encrypted
printf '%s' "$hash" | systemd-creds encrypt --name=admin-hash - /etc/credstore.encrypted/heads-up.admin-hash 2>/dev/null
chmod 600 /etc/credstore.encrypted/heads-up.admin-hash
unset hash

if [[ -n $generated ]]; then
  echo
  echo "  Username: admin"
  echo "  Password: $pw"
  echo
  echo "  Write it down or put it in a password manager. It is not shown again."
  echo
fi
unset pw again
echo "Admin password stored."
if systemctl is-active -q heads-up 2>/dev/null; then
  systemctl restart heads-up
  echo "Restarted heads-up; the new password works now."
fi
