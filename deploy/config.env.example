# /etc/heads-up/config.env — copy to deploy/config.env (not in git) and edit.
# The address people type in the browser; the certificate is issued for it.
SERVER_NAME=192.0.2.10
HU_HTTPS_PORT=9443
HU_HTTP_PORT=9080
# Ubuntu releases to report fix status for (codenames).
HU_UBUNTU_RELEASES="resolute noble jammy"
# Fortinet products you run (PSIRT advisories for others are hidden unless exploited).
HU_FORTINET_PRODUCTS="FortiOS,FortiAnalyzer,FortiClient"
