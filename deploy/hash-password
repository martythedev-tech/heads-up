#!/usr/bin/env python3
"""Read a password from stdin and print its scrypt hash in the form app.py checks."""
import hashlib
import os
import sys

password = sys.stdin.readline().rstrip("\n")
if not password:
    sys.exit("empty password")
n, r, p = 2**14, 8, 1
salt = os.urandom(16)
digest = hashlib.scrypt(password.encode(), salt=salt, n=n, r=r, p=p, dklen=32)
print(f"scrypt:{n}:{r}:{p}:{salt.hex()}:{digest.hex()}")
